      "id": "T2_ARITH_01",
      "chapter": "suites-arith",
      "solver": "arithSeq",
      "title": "Terme et somme d’une suite arithmétique",
      "difficulty": 1,
      "statement": "Une suite arithmétique a pour premier terme u₁ et pour raison r. Calculer uₙ puis la somme Sₙ = u₁ + … + uₙ. Formules du cours : uₙ = u₁ + (n−1)r et Sₙ = n(u₁ + uₙ)/2.",
      "variables": [
        {"key": "u1", "label": "Premier terme u₁", "unit": "—", "value": 3, "min": -5, "max": 12, "step": 1},
        {"key": "r", "label": "Raison r", "unit": "—", "value": 4, "min": -6, "max": 8, "step": 1},
        {"key": "n", "label": "Rang n", "unit": "—", "value": 10, "min": 4, "max": 20, "step": 1}
      ],
      "questions": [
        {"key": "un", "label": "uₙ", "unit": "—"},
        {"key": "sn", "label": "Sₙ", "unit": "—"}
      ]
    },
    {
