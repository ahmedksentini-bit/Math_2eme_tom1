        {"key": "n", "label": "Rang n", "unit": "—", "value": 5, "min": 3, "max": 8, "step": 1}
      ],
      "questions": [
        {"key": "un", "label": "uₙ", "unit": "—"},
        {"key": "sn", "label": "Sₙ", "unit": "—"}
      ]
    },
